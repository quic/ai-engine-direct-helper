dist/
# Note: build/ matches the repo-root build/ artifacts dir.
# IMPORTANT: anchored with leading "/" so it ONLY matches repo-root.
# Unanchored `build/` recursively swallowed source dirs like
# tools/qaiappbuilder/scripts/build/ (model_builder_cli.py), silently
# excluding them from the remote.
/build/
/lib/
*.egg-info/
*.whl
__pycache__/
*.pyc
script/qai_appbuilder/libs/

# Local agent / assistant scratch directories (tool output, diffs, attached files).
# Unanchored so it also covers tools/qaiappbuilder/.qai and .attachments.
.qai/
.attachments/
